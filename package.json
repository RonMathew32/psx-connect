{
  "name": "psx-connect",
  "version": "1.0.0",
  "description": "FIX Protocol implementation for Pakistan Stock Exchange in Node.js",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc && mkdir -p dist/config && cp src/config/config.json dist/config/",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "start-sql": "sudo systemctl start mysql",
    "generate-migration": "sequelize-cli migration:generate --name create-fix_messages",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate-undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed-permission": "sequelize-cli db:seed --seed create-permissions-seeder.js",
    "db:seed-undo": "sequelize-cli db:seed:undo:all",
    "generate-seeder": "sequelize-cli seed:generate --name pk-finance-seeder",
    "sequelize": "sequelize-cli",
    "db:create": "sequelize-cli db:create"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fixparser": "^9.0.6",
    "ioredis": "^5.6.1",
    "moment": "^2.30.1",
    "mysql2": "^3.14.1",
    "node-cron": "^4.1.0",
    "sequelize": "^6.37.7",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.17.30",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.18.1",
    "jest": "^29.6.2",
    "sequelize-cli": "^6.6.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
